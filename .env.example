# === SUPABASE ===
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === TWILIO ===
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+440000000000

# === VOICE PROVIDER ===
# Valid: twilio | telnyx | signalwire
VOICE_PROVIDER=twilio

# === TELNYX (required if VOICE_PROVIDER=telnyx) ===
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=

# === SIGNALWIRE (placeholder) ===
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=
SIGNALWIRE_SPACE_URL=example.signalwire.com

# === OPENAI ===
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_REALTIME_MODEL=gpt-realtime-mini

# === VOICE RENDERER ===
# Valid: openai | cartesia | elevenlabs
VOICE_RENDERER=openai

# === CARTESIA (required if VOICE_RENDERER=cartesia) ===
# Sign up at https://cartesia.ai
# Create a voice in the Cartesia dashboard to get a voice ID
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2

# === VOICE RUNTIME ===
# Valid: custom | deepgram_agent
# custom = existing OpenAI/Cartesia pipeline (default)
# deepgram_agent = Deepgram full-duplex agent (experimental)
VOICE_RUNTIME=custom

# === DEEPGRAM (required if VOICE_RUNTIME=deepgram_agent) ===
DEEPGRAM_API_KEY=8486d47f8b0f5bc7bad291b3bdc8c39b19f90304
DEEPGRAM_LISTEN_MODEL=nova-3
DEEPGRAM_LISTEN_LANGUAGE=en
DEEPGRAM_TTS_MODEL=aura-2-pandora-en
DEEPGRAM_THINK_PROVIDER=open_ai
DEEPGRAM_THINK_MODEL=gpt-4o-mini

# === GO GATEWAY ===
GATEWAY_PORT=8080
GATEWAY_WS_URL=wss://voice.voxlane.com/stream
GATEWAY_MAX_CONCURRENT_CALLS=100
GATEWAY_MAX_CALL_DURATION_SECONDS=1800
GATEWAY_SILENCE_TIMEOUT_PROMPT_SECONDS=10
GATEWAY_SILENCE_TIMEOUT_HANGUP_SECONDS=20

# === REDIS ===
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# === NESTJS ===
NESTJS_PORT=3000
NESTJS_URL=http://localhost:3000

# === HMAC (Go <-> NestJS) ===
HMAC_SECRET=dev-hmac-secret-change-in-production

# === ENVIRONMENT ===
NODE_ENV=development
LOG_LEVEL=debug
