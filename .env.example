# === SUPABASE ===
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === TWILIO ===
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+440000000000

# === VOICE PROVIDER ===
VOICE_PROVIDER=twilio

# === OPENAI ===
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_REALTIME_MODEL=gpt-realtime-1.5

# === VOICE RUNTIME (current production) ===
VOICE_RUNTIME=custom
VOICE_RENDERER=cartesia

# === CARTESIA ===
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_VOICE_ID=your-cartesia-voice-id
CARTESIA_MODEL=sonic-3.5
CARTESIA_LANGUAGE=en
CARTESIA_SPEED=1
CARTESIA_VOLUME=1
CARTESIA_EMOTION=content

# === GO GATEWAY ===
GATEWAY_PORT=8080
GATEWAY_WS_URL=wss://voice.voxlane.com/stream
GATEWAY_MAX_CONCURRENT_CALLS=100
GATEWAY_MAX_CALL_DURATION_SECONDS=1800
GATEWAY_SILENCE_TIMEOUT_PROMPT_SECONDS=10
GATEWAY_SILENCE_TIMEOUT_HANGUP_SECONDS=20

# === REDIS ===
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# === NESTJS ===
NESTJS_PORT=3000
NESTJS_URL=http://localhost:3000

# === HMAC (Go <-> NestJS) ===
HMAC_SECRET=dev-hmac-secret-change-in-production

# === ENVIRONMENT ===
NODE_ENV=development
LOG_LEVEL=debug
