# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
# Lines below are suggestions — uncomment to activate.
# Use ! prefix to force-include something excluded by defaults.
#
# Built-in defaults (always excluded unless negated):
#   node_modules/, .git/, dist/, build/, obj/, *.lock, *.min.js, etc.
#

# --- Project-specific exclusions (active) ---

# Planning tool working dir (Sisyphus plans, not project code)
.sisyphus/

# Pre-built analysis artifact (HTML, regenerated by separate tool)
voxlane_architecture.html

# Environment files (secrets / templates — never analyze contents)
.env
.env.*
!.env.example

# Built binary (Go build output)
voice-gateway/gateway.exe

# Experimental directory (explicitly labeled by the project as experimental).
# Narrowed: only the spike dirs that have been archived / superseded.
# The xai-phone-worker and multi-vendor-spike are ACTIVE; keep them in the graph.
experimental/livekit/xai-voice-agent/
experimental/livekit/web-client/

# Auto-generated TS incremental build info
backend/tsconfig.tsbuildinfo

# Generated git diff against VPS (created by ad-hoc tooling)
shared/package-lock.json
