# Production Environment Template
#
# Copy to /opt/ai-voice-receptionist/.env
# chmod 600 /opt/ai-voice-receptionist/.env
# Replace ALL placeholders with real values.

# ─── Node / Environment ───────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ─── Gateway ───────────────────────────────────────────────────────
GATEWAY_PORT=8080
GATEWAY_WS_URL=wss://<your-domain>/stream
GATEWAY_MAX_CONCURRENT_CALLS=100
GATEWAY_MAX_CALL_DURATION_SECONDS=1800
GATEWAY_SILENCE_TIMEOUT_PROMPT_SECONDS=10
GATEWAY_SILENCE_TIMEOUT_HANGUP_SECONDS=20

# ─── Backend ───────────────────────────────────────────────────────
NESTJS_PORT=3001
NESTJS_URL=http://localhost:3001
HMAC_SECRET=<generate-random-string-64-chars>

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ─── Runtime Lock ──────────────────────────────────────────────────
# DO NOT CHANGE: locked to custom+cartesia for production
VOICE_RUNTIME=custom
VOICE_RENDERER=cartesia
VOICE_PROVIDER=twilio

# ─── Telephony ─────────────────────────────────────────────────────
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>

# ─── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-<your-openai-api-key>
OPENAI_REALTIME_MODEL=gpt-realtime-1.5

# ─── Cartesia ──────────────────────────────────────────────────────
CARTESIA_API_KEY=<your-cartesia-api-key>
CARTESIA_VOICE_ID=<your-cartesia-voice-id>
CARTESIA_MODEL=sonic-3.5
CARTESIA_LANGUAGE=en
CARTESIA_SPEED=0.95
CARTESIA_VOLUME=0.90
CARTESIA_EMOTION=content

# ─── Telnyx (future — do not enable yet) ───────────────────────────
# TELEPHONY_PROVIDER=telnyx
# TELNYX_API_KEY=<your-telnyx-api-key>
# TELNYX_CONNECTION_ID=<your-telnyx-connection-id>
# TELNYX_PHONE_NUMBER=<your-telnyx-phone-number>
# TELNYX_WEBHOOK_SECRET=<generate-random-string>
# TELNYX_STREAM_CODEC=PCMU
# TELNYX_BIDIRECTIONAL_CODEC=PCMU

# ─── Business ──────────────────────────────────────────────────────
BUSINESS_NAME=Your Business Name
