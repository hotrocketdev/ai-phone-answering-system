# conversation-worker env vars — copy to experimental/livekit/.env and fill in.
# This file is committed; .env is gitignored.

# LiveKit Cloud (or self-hosted) URL — wss://... required.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Cartesia API key (for HD audio generation on the outbound side).
# If empty, the worker falls back to a 5s 440 Hz test tone on the
# first inbound frame (still proves the full two-way path).
CARTESIA_API_KEY=

# Cartesia voice/model. Match the spike publisher's locked-in config.
CARTESIA_VOICE_ID=273f9ef7-9fc2-4def-88bb-ab108c6249ca
CARTESIA_MODEL=sonic-3.5
CARTESIA_RATE=48000
CARTESIA_ENCODING=pcm_f32le

# Filter chain forwarded to ffmpeg on the outbound Opus encode.
FILTER_CHAIN=highpass=f=80,lowpass=f=12000,anlmdn=s=0.0001:p=0.004:r=0.012

# Opus encode settings (matches the spike publisher).
OPUS_BITRATE=64000
OPUS_APPLICATION=audio

# OpenAI API key (for Stage 1+ STT via whisper-1 and LLM via gpt-4o-mini).
# Required for the real-conversation engine. If empty, STT and LLM calls
# will fail and turns will log warnings (the worker still runs).
OPENAI_API_KEY=

# VAD silence timeout in milliseconds. How long we wait after the last
# inbound Opus frame before ending the current utterance. 500ms covers
# natural pauses in speech without feeling laggy.
VAD_SILENCE_TIMEOUT_MS=500

# Stage 1 reply strategy is no longer env-gated; the worker is always
# in "per_utterance" mode. The legacy REPLY_MODE/REPLY_TEXT env vars
# from Stage 2 are ignored.

# Room / identity for the worker.
WORKER_ROOM=voxlane-conv-spike
WORKER_IDENTITY=voxlane-conv-worker

# ---- Worker mode (Stage 1 vs Stage 1.5) --------------------------------
# stitched (default) = Whisper STT + gpt-4o-mini LLM + Cartesia TTS.
# realtime          = OpenAI Realtime API (single WebSocket, sub-1s
#                     latency, voice mimicry, server VAD). Server-side
#                     TTS audio deltas are currently not delivered by
#                     OpenAI as of 2026-06 — see realtime-cartesia.
# realtime-cartesia = OpenAI Realtime for STT + LLM (server VAD), but
#                     the assistant's text is buffered by sentence and
#                     sent to Cartesia Sonic 3.5 + Julia for TTS.
#                     Restores the natural Alex voice while keeping
#                     Realtime's low-latency STT + LLM. Recommended.
LIVEKIT_WORKER_MODE=stitched

# ---- Stage 1.5: OpenAI Realtime (used when LIVEKIT_WORKER_MODE=realtime)
# Lowest-cost voice model on this account (text $0.60 / audio ~$4.80
# per 1M input tokens; text $2.40 / audio ~$19.20 per 1M output tokens).
REALTIME_MODEL=gpt-realtime-mini
# OpenAI voice. alloy=neutral, marin=calm, coral=warm, sage=thoughtful,
# shimmer=bright, verse=deep, ballad=gentle, echo=warm-male, ash=male,
# cedar=male. Pick what fits Alex.
REALTIME_VOICE=marin
# Minimal receptionist prompt (per spike scope — no booking tools).
REALTIME_INSTRUCTIONS=You are Alex, a calm restaurant receptionist. Reply briefly and naturally. Do not over-explain. Ask one question at a time.
# Server-side VAD tuning. Higher threshold = less sensitive (echo
# robust). Longer silence_duration_ms = user must pause longer before
# Realtime commits the buffer.
REALTIME_VAD_THRESHOLD=0.75
REALTIME_VAD_SILENCE_MS=600
REALTIME_VAD_PREFIX_MS=200

# ---- Stage 1.5: outbound Opus encode (Realtime PCM 24kHz -> Opus 48kHz)
REALTIME_OPUS_BITRATE=96000
# Inbound filter chain forwarded to ffmpeg on the OGG-Opus -> PCM24
# decode (Realtime mode). Minimal: highpass only. RNNoise (anlmdn) was
# found to suppress real speech along with noise in earlier tests.
REALTIME_INBOUND_FILTER=highpass=f=80

# ---- Stage 1.5 realtime-cartesia: Cartesia TTS settings --------------
# In realtime-cartesia mode the assistant's text is sent to Cartesia
# per-sentence. The CARTESIA_API_KEY / CARTESIA_VOICE_ID / CARTESIA_MODEL
# / CARTESIA_ENCODING variables above are reused as-is.
#
# CARTESIA_RATE is what the outbound Opus encoder reads at. The
# long-lived outbound encoder (opusEncodeContinuousCmd) is hardcoded
# to 24000 Hz input, so CARTESIA_RATE MUST be 24000 in
# realtime-cartesia mode. If you set it to anything else the
# encoder will resample on the fly (CPU cost, slight quality loss).
# Override here for the spike only; the production env (CARTESIA_RATE
# used in stitched mode) is untouched.
CARTESIA_RATE=24000
# Sentence buffer cap: a sentence longer than this many characters
# is force-flushed to Cartesia. Default 200 keeps TTS bursts under
# ~15s even if the LLM rambles without terminal punctuation.
REALTIME_CARTESIA_MAX_CHARS=200
