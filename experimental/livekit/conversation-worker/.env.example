# conversation-worker env vars — copy to experimental/livekit/.env and fill in.
# This file is committed; .env is gitignored.

# LiveKit Cloud (or self-hosted) URL — wss://... required.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Cartesia API key (for HD audio generation on the outbound side).
# If empty, the worker falls back to a 5s 440 Hz test tone on the
# first inbound frame (still proves the full two-way path).
CARTESIA_API_KEY=

# Cartesia voice/model. Match the spike publisher's locked-in config.
CARTESIA_VOICE_ID=273f9ef7-9fc2-4def-88bb-ab108c6249ca
CARTESIA_MODEL=sonic-3.5
CARTESIA_RATE=48000
CARTESIA_ENCODING=pcm_f32le

# Filter chain forwarded to ffmpeg on the outbound Opus encode.
FILTER_CHAIN=highpass=f=80,lowpass=f=12000,anlmdn=s=0.0001:p=0.004:r=0.012

# Opus encode settings (matches the spike publisher).
OPUS_BITRATE=64000
OPUS_APPLICATION=audio

# Reply strategy:
#   "fixed_on_first_frame"  - Stage 2: trigger Cartesia reply on the first
#                              inbound Opus frame. Simple spike proof of
#                              the two-way loop. No VAD, no OpenAI.
#   "tone_on_first_frame"   - Stage 1: play a 440 Hz test tone on first
#                              inbound frame. No Cartesia needed.
#   "none"                  - Stage 1 only: subscribe + log, no outbound.
REPLY_MODE=fixed_on_first_frame

# Fixed greeting text used in "fixed_on_first_frame" mode.
REPLY_TEXT=Hi there, this is Alex. Yes, I can hear you. How can I help today?

# Room / identity for the worker.
WORKER_ROOM=voxlane-conv-spike
WORKER_IDENTITY=voxlane-conv-worker
