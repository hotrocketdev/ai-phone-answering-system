# LiveKit spike publisher — placeholder env vars
# Copy to .env and fill in real values locally. Do NOT commit .env.

# LiveKit Cloud (or self-hosted) URL
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API credentials (generate in LiveKit Cloud dashboard)
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Cartesia API key (for HD audio generation)
CARTESIA_API_KEY=your-cartesia-key

# Cartesia voice/model (must match production or be a spike-specific voice)
CARTESIA_VOICE_ID=2f251ac3-89a9-4a77-a452-704b474ccd01
CARTESIA_MODEL=sonic-3.5

# Test greeting text
SPIKE_GREETING_TEXT=Hello, this is a LiveKit HD audio test from VoxLane.
