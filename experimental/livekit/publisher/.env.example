# LiveKit spike publisher — placeholder env vars
# Copy to experimental/livekit/.env and fill in real values locally. Do NOT commit .env.
# This file is committed; .env is gitignored.

# LiveKit Cloud (or self-hosted) URL — wss://... required
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API credentials (generate in LiveKit Cloud dashboard)
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Cartesia API key (for HD audio generation). If empty, a 5s test tone is used.
CARTESIA_API_KEY=

# Cartesia voice/model
# Default voice: Julia - Gentle Guide (273f9ef7-9fc2-4def-88bb-ab108c6249ca)
#   "Soft, graceful tone with a composed rhythm for polished guidance
#   and reassurance." British English (country=GB).
# Other voices tested in the sonic-3.5 optimisation round (2026-06-04):
#   Victoria  dc30854e-e398-4579-9dc8-16f6cb2c19b9  Refined Coordinator
#   Lucy      2f251ac3-89a9-4a77-a452-704b474ccd01  Capable Coordinator (previous default)
#   Gemma     62ae83ad-4f6a-430b-af41-a9bede9286ca  Decisive Agent
#   Evie      e5d4c33a-d8f6-46e8-a10f-b5afecc35648  Engaging Expert
#   Pippa     81cd8d19-45e7-47b2-ad0e-bcd94f557ad0  Bright Assistant
#   Arthur    bb7e8daa-8b79-47a2-8408-a7a1cc72b53c  Polished Advisor (male)
CARTESIA_VOICE_ID=273f9ef7-9fc2-4def-88bb-ab108c6249ca
CARTESIA_MODEL=sonic-3.5

# Test greeting
SPIKE_GREETING_TEXT=Porto Douro Restaurants, Alex speaking. How can I help?

# Sonic-3.5 optimisation env vars (2026-06-04, see HANDOVER_CURRENT_STATE.md).
# Defaults give the proven best pipeline: 48 kHz pcm_f32le + Opus 64 kbps.
# Uncomment to override.
#SPIKE_CARTESIA_RATE=48000           # 8000, 16000, 22050, 24000, 44100, 48000
#SPIKE_CARTESIA_ENCODING=pcm_f32le   # pcm_f32le, pcm_s16le, pcm_mulaw, pcm_alaw
#SPIKE_FILTER_CHAIN=highpass=f=80,lowpass=f=12000,anlmdn=s=0.0001:p=0.004:r=0.012
#SPIKE_OPUS_BITRATE=64000            # 6000-510000
#SPIKE_OPUS_APPLICATION=audio        # audio or voip
#SPIKE_NO_FILTER=false               # true to skip ffmpeg audio filters
#SPIKE_SAVE_PCM=                     # path; if set, raw Cartesia PCM is also saved to a WAV

# If true, publisher waits for a remote participant (listener) to join
# before publishing. Useful for browser tests where you need time to
# set up the web client. Default: false (publishes immediately).
SPIKE_WAIT_FOR_SUBSCRIBER=false
